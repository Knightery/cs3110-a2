 (main_module_name A2)
 (modes byte native)
 (modules
  (wrapped
   (group
    (alias
     (obj_name a2)
     (visibility public)
     (kind alias)
     (source (path A2) (impl (path a2.ml-gen))))
    (name A2)
    (modules
     (module
